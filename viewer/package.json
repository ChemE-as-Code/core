{
  "name": "cheme-as-code-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only web viewer for a cheme-as-code plant repository (served by cheme serve).",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "typecheck": "vue-tsc --build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vite build && playwright test",
    "build:static": "vue-tsc --build && vite build --base ./ --outDir dist-static"
  },
  "dependencies": {
    "jspdf": "4.2.1",
    "svg2pdf.js": "2.9.0",
    "three": "0.186.1",
    "vue": "3.5.45",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/three": "0.186.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/tsconfig": "0.9.1",
    "jsdom": "31.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "core-js": "3.50.0"
  }
}
